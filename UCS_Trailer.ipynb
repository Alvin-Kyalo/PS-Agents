   "source": [
    "## 2. UCS implementation\n",
    "`heapq` is used as the priority queue. Each frontier entry is `(g, tie_breaker, town, path)`. The tie-breaker keeps ordering deterministic when two entries have equal cost."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "0bfd27f7",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-06T17:39:09.701800Z",
     "iopub.status.busy": "2026-11-06T17:39:09.701607Z",
     "iopub.status.idle": "2026-11-06T17:39:09.711507Z",
     "shell.execute_reply": "2026-11-06T17:39:09.710441Z"
    }
   },
   "outputs": [],
   "source": [
    "import heapq\n",
    "from itertools import count\n",
    "\n",
    "def fmt(x):\n",
    "    \"\"\"Print 87.0 as 87 and 41.1 as 41.1\"\"\"\n",
    "    return f\"{x:g}\"\n",
    "\n",
    "def uniform_cost_search(graph, start, goal, verbose=True):\n",
    "    tie = count()\n",
    "    frontier = [(0, next(tie), start, [start])]   # (g, tie, town, path)\n",
    "    explored = set()\n",
    "    best_g = {start: 0}                            # cheapest known cost to each town\n",
    "    step = 0\n",
    "\n",
    "    while frontier:\n",
    "        step += 1\n",
    "        g, _, town, path = heapq.heappop(frontier)\n",
    "\n",
    "        # Skip stale entries: a cheaper route to this town was already expanded\n",
    "        if town in explored:\n",
    "            continue\n",
    "\n",
    "        if verbose:\n",
    "            print(f\"\\n--- Step {step} ---\")\n",
    "            print(f\"Expand  : {town}  (g = {fmt(g)} km)\")\n",
    "            print(f\"Path    : {' -> '.join(path)}\")\n",
    "\n",
    "        # Goal test on EXPANSION (guarantees optimality)\n",
    "        if town == goal:\n",
    "            if verbose:\n",
    "                print(f\"GOAL REACHED: {goal}\")\n",
    "            return path, g\n",
    "\n",
    "        explored.add(town)\n",
    "\n",
    "        for nbr, km in graph[town]:\n",
    "            new_g = g + km\n",
    "            if nbr in explored:\n",
    "                if verbose:\n",
    "                    print(f\"  skip {nbr} (already explored)\")\n",
    "                continue\n",
    "            if nbr not in best_g or new_g < best_g[nbr]:\n",
    "                best_g[nbr] = new_g\n",
    "                heapq.heappush(frontier, (new_g, next(tie), nbr, path + [nbr]))\n",
    "                if verbose:\n",
    "                    print(f\"  add  {nbr:<10} g = {fmt(g)} + {fmt(km)} = {fmt(new_g)}\")\n",
    "            elif verbose:\n",
    "                print(f\"  skip {nbr:<10} g = {fmt(new_g)} (not cheaper than {fmt(best_g[nbr])})\")\n",
    "\n",
    "        if verbose:\n",
    "            live = sorted((e for e in frontier if e[2] not in explored), key=lambda e: (e[0], e[1]))\n",
    "            print(\"Frontier:\", [(e[2], fmt(e[0])) for e in live])\n",
    "            print(\"Explored:\", sorted(explored))\n",
    "\n",
    "    return None, float(\"inf\")"
   ]
  },
